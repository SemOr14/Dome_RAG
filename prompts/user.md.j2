{% endif %}

# Замеченные аномалии (эвристики агента, могут быть неполными)
{% if anomalies %}
{% for a in anomalies %}
- {{ a.node }}{% if a.param %}.{{ a.param }}{% endif %} = {{ a.value | tojson }} — {{ a.note }}
{% endfor %}
{% else %}
