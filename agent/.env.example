# Скопируйте в .env (файл .env в git не попадает). Ключи и адрес можно не вписывать в .env,
# если лежит файл ключей (KEYS_FILE): строки "team: <ключ купола>" и "deepseek: <ключ DeepSeek>".

# --- подключение к куполу (обязательно) ---
DOME_URL=ws://192.168.8.10:8765
DOME_KEY=
# Управление куполом (control, в том числе сообщения в чат) разрешено ТОЛЬКО при DOME_ALLOW_CONTROL=1.
# По умолчанию агент работает «только чтение»: решения пишутся в лог, команды в сеть не уходят.
# DOME_ALLOW_CONTROL=0
# Всё анализировать и писать в лог, но не отправлять команды (приоритетнее DOME_ALLOW_CONTROL)
# AGENT_DRY_RUN=1

# --- языковая модель ---
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- прочее ---
# Файл с ключами: строки "team: ..." и "deepseek: ..." (по умолчанию Dome_RAG/Keys/team_1.txt)
# KEYS_FILE=Dome_RAG/Keys/team_1.txt
# Каталог логов агента (по умолчанию logs)
# AGENT_LOG_DIR=logs
# Каталог с материалами организаторов для RAG (knowledge/, Logs/)
DOME_RAG_DIR=..
