# LLM (разрешён только DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Если DEEPSEEK_API_KEY пуст — ключ читается из строки "deepseek:" этого файла
KEYS_FILE=Keys/team_1.txt

# Шаблоны промпта и данные-заглушки
PROMPT_TEMPLATE_DIR=prompts
DATA_DIR=data

# Размер секций промпта
PROMPT_JOURNAL_LIMIT=15
PROMPT_RAG_K=3
PROMPT_GRAPH_DEPTH=1

# RAG: auto — RAG Купола из RAG_DIR, при его отсутствии BM25 по data/rag; dome | keyword | none
RAG_BACKEND=auto
RAG_DIR=rag
# 0 — только BM25, без локальной ONNX-модели (без неё поиск и так откатывается на BM25)
RAG_SEMANTIC=1

# Сервис БД/API (services/data_api). Пустой URL — файловые заглушки data/samples/
DATA_API_URL=
# Тот же токен, что DATA_API_TOKEN сервиса; в логи и промпт не попадает
DATA_API_TOKEN=
# Пусто — последний запуск в БД и сессия его последнего auth_response
# Для веб-панели: фиксируйте run_id одной физической смены между перезапусками,
# иначе создастся новый случайный run_id и прежние бюджеты/очередь не загрузятся.
# Для нового опыта, симуляции и другого Купола используйте отдельные run_id.
DATA_API_RUN_ID=
DATA_API_SESSION_ID=
DATA_API_TIMEOUT_S=5
# 1 — каждое предложенное действие проходит POST /v1/controls/validate
DATA_API_CHECK_CONTROLS=1
# Локальная очередь недоставленных событий
STATE_DIR=state

# Диспетчер вызовов модели (run_dispatcher.py, rag/AGENT_TRIGGERS.md). Значения предварительные
TRIGGER_POLL_S=2
TRIGGER_MIN_INTERVAL_S=10
TRIGGER_COOLDOWN_S=120
# 0 — без фонового обзора
TRIGGER_REVIEW_S=180
TRIGGER_STALE_S=30
TRIGGER_STALL_S=180
TRIGGER_VERIFY_MIN_S=5
TRIGGER_VERIFY_RETRIES=2
TRIGGER_LLM_RETRIES=2

# Управление производством: до уточнения объёма API только история
DOME_API_SCOPE=history
DEPLOYMENT_PROFILE=competition
AGENT_MODE=recommendation
ALGORITHMS_ENABLED=1
PRINTER_SUPERVISION_S=12
# Только SHA-256 готовых файлов, подготовленных организаторами, через запятую
PRODUCTION_APPROVED_SHA256=
YELLOW_PLAN_TIMEOUT_S=180
YELLOW_NOZZLE_SAFE_C=50
CRITICAL_LINE_MAP={}
