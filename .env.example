# LLM (разрешён только DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Если DEEPSEEK_API_KEY пуст — ключ читается из строки "deepseek:" этого файла
KEYS_FILE=Keys/team_1.txt

# Шаблоны промпта и данные-заглушки
PROMPT_TEMPLATE_DIR=prompts
DATA_DIR=data

# Размер секций промпта
PROMPT_JOURNAL_LIMIT=15
PROMPT_RAG_K=3
PROMPT_GRAPH_DEPTH=1

# RAG: auto — RAG Купола из RAG_DIR, при его отсутствии BM25 по data/rag; dome | keyword | none
RAG_BACKEND=auto
RAG_DIR=rag
# 0 — только BM25, без локальной ONNX-модели (без неё поиск и так откатывается на BM25)
RAG_SEMANTIC=1

# Сервис БД/API (services/data_api). Пустой URL — файловые заглушки data/samples/
DATA_API_URL=
# Тот же токен, что DATA_API_TOKEN сервиса; в логи и промпт не попадает
DATA_API_TOKEN=
# Пусто — последний запуск в БД и сессия его последнего auth_response
DATA_API_RUN_ID=
DATA_API_SESSION_ID=
DATA_API_TIMEOUT_S=5
# 1 — каждое предложенное действие проходит POST /v1/controls/validate
DATA_API_CHECK_CONTROLS=1
# Локальная очередь недоставленных событий
STATE_DIR=state
